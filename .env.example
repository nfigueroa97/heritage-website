# Leave empty to store content in this browser. Set to enable GET/PUT {url}/content.
VITE_API_URL=

# Google Analytics 4 measurement id. Empty disables analytics.
VITE_GA_ID=

# Third-party chat widget script URL. Empty shows no chat.
VITE_CHAT_SRC=

# Admin screen password. If empty, the screen accepts "heritage".
# This value is bundled into the site. It is not a server session.
VITE_ADMIN_PASSWORD=heritage
